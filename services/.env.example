# -- Solana cluster --
# RPC endpoint the services will read/write through.
# For local dev: http://127.0.0.1:8899
# For devnet:    https://api.devnet.solana.com
RPC_URL=http://127.0.0.1:8899

# Commitment level for subscriptions and confirmations.
COMMITMENT=confirmed

# -- Keypair --
# Path to the signer's keypair JSON (the classic `solana-keygen` format).
# The price-feed poster signs `set_price`; the bot signs `liquidate`.
# Both use the same env var, pick different wallets in different processes.
WALLET_PATH=/Users/you/.config/solana/id.json

# -- Program IDs --
# Must match `declare_id!` in each program after `anchor build`.
LENDING_PROGRAM_ID=EgYyi4Htyoe7AVDBKfFD8T2LxswDfK6BVYt7vvCXSFtK
STAKING_PROGRAM_ID=221frxT7k1xFtwd4y7iWimUxiBe97zdte61mX7NTkkt9

# -- Collateral mint (nSOL) --
# Needed for oracle PDA derivation and for the liquidator's collateral ATA.
COLLATERAL_MINT=

# -- Debt mint (mock USDC) --
# Needed for the liquidator's debt ATA.
DEBT_MINT=

# -- Price-feed poster --
# CoinGecko asset id for the price you want to post as "nSOL" price.
# For a real liquid-staking token you'd track something like `marinade-staked-sol`;
# for the tutorial just treat nSOL as 1:1 SOL.
COINGECKO_ASSET_ID=solana
# How often to push a new price (ms).
PRICEFEED_INTERVAL_MS=30000

# -- Liquidation bot --
# How often to re-scan every UserLoan (ms).
BOT_SCAN_INTERVAL_MS=10000
# Safety margin (bps) beyond the liquidation threshold before acting. This
# leaves room for oracle latency so we don't race a healthy account into a
# failed liquidate call.
BOT_TRIGGER_BUFFER_BPS=25
# Maximum fraction (bps) of the outstanding debt we try to repay in a
# single liquidate call. The on-chain close factor is the ceiling;
# this is an extra dial for testing.
BOT_MAX_REPAY_BPS=5000
# Dry run: compute + log but don't send transactions.
BOT_DRY_RUN=true
