{
  "name": "nutrifi-services",
  "version": "0.1.0",
  "private": true,
  "description": "Off-chain services for NutriFi: price-feed poster + liquidation bot.",
  "license": "MIT",
  "main": "dist/index.js",
  "bin": {
    "nutrifi-bot": "dist/bot/cli.js",
    "nutrifi-pricefeed": "dist/pricefeed/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bot": "ts-node --transpile-only src/bot/cli.ts",
    "pricefeed": "ts-node --transpile-only src/pricefeed/cli.ts",
    "bot:prod": "node dist/bot/cli.js",
    "pricefeed:prod": "node dist/pricefeed/cli.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.30.1",
    "@solana/spl-token": "^0.4.6",
    "@solana/web3.js": "^1.95.2",
    "bn.js": "^5.2.1",
    "dotenv": "^16.4.5",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.5",
    "@types/node": "^20.14.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=18"
  }
}
